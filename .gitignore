# Server-only upload secret/config — must never be committed (see upload.php)
assets/upload-config.php

# Media uploaded via the upload endpoint lives on the web host, not in Git
assets/uploads/

# Legacy WordPress-era media the old posts link to. Also host-only — ignored so
# a local copy pulled down for testing can never be committed by accident.
assets/old_assets/

# Build stamp written by the deploy workflow; not part of the source
version.json

# Precompressed copies of large binaries. Generated by the deploy workflow
# immediately before rsync (see .github/workflows/deploy-purely.yml) so they can
# never drift out of sync with the file they were built from.
*.wasm.gz

# Link-check bookkeeping: which URLs were reachable when, and the last sweep's
# report (see scripts/wayback_dead_links.py). Both are regenerated on demand.
.link-check-cache.json
link-report.md
